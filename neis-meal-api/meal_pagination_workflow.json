    {
      "parameters": {
        "jsCode": "const totalCount = $json.mealServiceDietInfo[0].head[0].list_total_count;\nconst pSize = $node[\"Set Configuration\"].json.pSize;\nconst totalPages = Math.ceil(totalCount / pSize);\n\nconst items = [];\nfor (let i = 1; i <= totalPages; i++) {\n  items.push({\n    pIndex: i,\n    pSize: pSize\n  });\n}\n\nreturn items;"
      },
