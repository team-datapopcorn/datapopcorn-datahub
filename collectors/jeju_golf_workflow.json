      "parameters": {
        "jsCode": "const results = [];\nconst rows = $json.data || [];\n\nfor (const row of rows) {\n  const address = row['소재지'] || row['소재지도로명주소'] || row['소재지지번주소'] || row['주소'] || '';\n  if (address.indexOf('제주') !== -1) {\n    results.push({ json: row });\n  }\n}\n\nreturn results;"
