    {
      "parameters": {
        "jsCode": "const totalCount = $json.totalCount;\nconst perPage = $node[\"Set Config\"].json.perPage;\nconst totalPages = Math.ceil(totalCount / perPage);\n\nconst items = [];\nfor (let i = 1; i <= totalPages; i++) {\n  items.push({\n    json: {\n      page: i,\n      perPage: perPage\n    }\n  });\n}\n\nreturn items;"
