      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1480,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst body = ($json.response && $json.response.body) || $json.body || $json;\n\nlet rows = [];\nconst items = body.items;\nif (Array.isArray(items)) {\n  rows = items;\n} else if (items && Array.isArray(items.item)) {\n  rows = items.item;\n} else if (items && items.item) {\n  rows = [items.item];\n} else if (Array.isArray(body.data)) {\n  rows = body.data;\n} else if (Array.isArray($json.data)) {\n  rows = $json.data;\n}\n\nconst addressKeys = ['소재지도로명주소', '도로명주소', '소재지지번주소', '지번주소', '소재지주소', '주소'];\n\nfor (const row of rows) {\n  let address = '';\n  for (const key of addressKeys) {\n    if (row[key]) { address = row[key]; break; }\n  }\n  if (address.indexOf('울릉군') !== -1) {\n    results.push({ json: row });\n  }\n}\n\nreturn results;"
      },
