    {
      "parameters": {
        "jsCode": "const body = ($json.response && $json.response.body) || $json.body || $json;\nconst totalCount = Number(body.totalCount || 0);\nconst numOfRows = $node[\"Set Config\"].json.numOfRows;\nconst totalPages = Math.ceil(totalCount / numOfRows);\n\nconst items = [];\nfor (let i = 1; i <= totalPages; i++) {\n  items.push({\n    json: {\n      pageNo: i,\n      numOfRows: numOfRows\n    }\n  });\n}\n\nreturn items;"
      },
