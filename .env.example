# data.go.kr service key — use the ENCODING key from 마이페이지 > 인증키 발급현황.
# Each API must be approved separately via 활용신청 on its dataset page.
DATA_GO_KR_SERVICE_KEY=

# Jeju golf (dataset 15118920, 전국 골프장 현황): odcloud open-API endpoint.
# Copy the full uddi URL from the dataset's 오픈 API tab after 활용신청.
DATA_GO_KR_JEJU_GOLF_ENDPOINT=https://api.odcloud.kr/api/15118920/v1/uddi:PUT-UUID-HERE
